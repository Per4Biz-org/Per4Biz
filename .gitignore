# Ignore all node_modules everywhere
**/node_modules/

# Ignore build outputs
dist/
build/
out/

# Ignore logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore environment files
.env
.env.local
.env.*.local

# Ignore IDE/editor config files
.vscode/
.idea/
*.sw?

# Ignore lock files if tu veux éviter les conflits (optionnel)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Ignore coverage reports
coverage/
